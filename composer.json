{
    "name": "evanschleret/laravel-user-presence",
    "description": "Another Laravel package for tracking user presence in real-time applications.",
    "keywords": [
        "EvanSchleret",
        "laravel",
        "presence"
    ],
    "homepage": "https://github.com/evanschleret/laravel-user-presence",
    "license": "MIT",
    "authors": [
        {
            "name": "Evan Schleret",
            "email": "evan@schleret.ch"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/broadcasting": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0|^5.0",
        "laravel/pint": "^1.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "EvanSchleret\\LaravelUserPresence\\Providers\\LaravelUserPresenceServiceProvider"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "EvanSchleret\\LaravelUserPresence\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EvanSchleret\\LaravelUserPresence\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
